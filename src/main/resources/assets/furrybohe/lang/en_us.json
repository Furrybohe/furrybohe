  "furrybohe.en.egg.1": "Congrats, you found the easter egg!",
  "furrybohe.en.egg.2": "Prize: a journey through the English-speaking world.",

  "furrybohe.en.egg.3": "Canada: wait 45 minutes for the YRT.",
  "furrybohe.en.egg.4": "Then wait 45 minutes for the TTC.",
  "furrybohe.en.egg.5": "For a 20-minute drive.",
  "furrybohe.en.egg.6": "\"We apologize for the inconvenience.\"",

  "furrybohe.en.egg.7": "USA: no bus, no train, no choice.",
  "furrybohe.en.egg.8": "Buy a car.",
  "furrybohe.en.egg.9": "Can't afford a car?",
  "furrybohe.en.egg.10": "\"That's a you problem.\"",

  "furrybohe.en.egg.11": "UK: the train is delayed.",
  "furrybohe.en.egg.12": "By 17 hours.",
  "furrybohe.en.egg.13": "It left the depot with no diesel.",
  "furrybohe.en.egg.14": "\"Ran on electric the whole way. Then the wires ended.\"",

  "furrybohe.en.egg.15": "Australia: you see a spider.",
  "furrybohe.en.egg.16": "It's the size of your hand.",
  "furrybohe.en.egg.17": "\"She'll be right.\"",
  "furrybohe.en.egg.18": "It's not.",

  "furrybohe.en.egg.19": "Germany: the train is 2 hours late.",
  "furrybohe.en.egg.20": "Why?",
  "furrybohe.en.egg.21": "\"We don't know either.\"",
  "furrybohe.en.egg.22": "The next train is also 2 hours late.",

  "furrybohe.en.egg.23": "France: the train is on strike.",
  "furrybohe.en.egg.24": "Why?",
  "furrybohe.en.egg.25": "\"It's Tuesday.\"",

  "furrybohe.en.egg.26": "Italy: the bus is coming.",
  "furrybohe.en.egg.27": "When?",
  "furrybohe.en.egg.28": "\"Domani.\"",
  "furrybohe.en.egg.29": "Tomorrow never comes.",

  "furrybohe.en.egg.30": "India: a tire flies over the plane.",
  "furrybohe.en.egg.31": "You look out the window.",
  "furrybohe.en.egg.32": "There's no plane. It's just a tire.",
  "furrybohe.en.egg.33": "This is a game in India.",
  "furrybohe.en.egg.34": "A tire on a diesel engine.",
  "furrybohe.en.egg.35": "One person runs to start it.",
  "furrybohe.en.egg.36": "Another pushes it off with a stick.",
  "furrybohe.en.egg.37": "A third holds a ladder.",
  "furrybohe.en.egg.38": "The tire flies. Try to hit the chimney.",
  "furrybohe.en.egg.39": "\"This is normal.\"",

  "furrybohe.en.egg.40": "§7—— The world: you wait, you pay, or you walk.§r"
}